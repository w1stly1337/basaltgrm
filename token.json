# Разрешаем тебе и другу доступ к админке
New-NetFirewallRule -DisplayName "gramsrv Admin Me and Friend" -Direction Inbound -Protocol TCP -LocalPort 2600 -Action Allow -RemoteAddress 151.249.235.105,2.27.57.51 -ErrorAction SilentlyContinue

# Проверяем, что правило есть
Get-NetFirewallRule -DisplayName "gramsrv Admin Me and Friend" | Get-NetFirewallPortFilter

# Проверяем, что telesrv-admin слушает порт 2600
Get-NetTCPConnection -LocalPort 2600 -State Listen

# Проверяем порт локально
Test-NetConnection -ComputerName 127.0.0.1 -Port 2600
